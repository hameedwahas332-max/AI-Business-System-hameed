{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Business System - Wahas ERP",
  "version": "2.4.1",
  "identifier": "com.wahas.aibusiness.erp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run icons:generate && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "نظام المحاسبي الذكي ERP - محلات وهاس للتجارة العامة",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:* ws://localhost:* https:; connect-src 'self' http://localhost:* ws://localhost:* https:; img-src 'self' asset: https: data: blob:; style-src 'self' 'unsafe-inline' https:; font-src 'self' https: data:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["Arabic", "English"],
        "displayLanguageSelector": true
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:erp_desktop_offline.db",
        "sqlite:erp_local_vault.db"
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCMTA0QkNCNkU4NzQ4OEMKUldTTVNJZHV5MHNRNjhSc3lrNGZ5T0lLTVl0L291NHEwbHF6N2ZZWXRjQks1VzFVWFRwU2o5dHkK",
      "endpoints": [
        "https://github.com/hameedwahas332-max/AI-Business-System-hameed/releases/latest/download/latest.json"
      ]
    }
  }
}
